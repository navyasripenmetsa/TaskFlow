<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TaskFlowButton" parent="android:style/Widget.Material.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="android:fontFamily">sans</item>
    </style>

    <style name="TaskFlowButton.Primary" parent="TaskFlowButton">
        <item name="android:backgroundTint">@color/primary</item>
    </style>

    <style name="TaskFlowButton.Secondary" parent="TaskFlowButton">
        <item name="android:backgroundTint">@color/surface_subtle</item>
        <item name="android:textColor">@color/primary_dark</item>
    </style>
</resources>
