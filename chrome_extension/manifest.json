{
  "manifest_version": 3,
  "name": "TaskFlow ContextItem Collector",
  "version": "1.0.0",
  "description": "Collects tab metadata and visible page text into TaskFlow ContextItem JSON.",
  "permissions": ["tabs", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["page-content.js"],
      "run_at": "document_idle"
    }
  ],
  "incognito": "not_allowed"
}
